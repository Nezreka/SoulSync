# Auto detect text files and perform LF normalization
* text=auto

# Force Unix line endings for shell scripts (required for Docker)
*.sh text eol=lf

# Generated by the TanStack router plugin during the webui build, which always
# writes LF. Without this it is checked out with CRLF (GitHub Desktop on
# Windows), so every `npm run build` leaves it "modified" with a zero-content
# diff and blocks pulls. Nobody edits this file by hand.
webui/src/routeTree.gen.ts text eol=lf
