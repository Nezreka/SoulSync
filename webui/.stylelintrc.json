{
  "extends": [
    "stylelint-config-standard"
  ],
  "rules": {
    "alpha-value-notation": null,
    "at-rule-empty-line-before": null,
    "color-function-alias-notation": null,
    "color-function-notation": null,
    "color-hex-length": null,
    "comment-empty-line-before": null,
    "comment-whitespace-inside": null,
    "custom-property-empty-line-before": null,
    "declaration-block-no-redundant-longhand-properties": null,
    "declaration-block-single-line-max-declarations": null,
    "declaration-empty-line-before": null,
    "font-family-name-quotes": null,
    "function-url-quotes": null,
    "length-zero-no-unit": null,
    "media-feature-range-notation": null,
    "no-descending-specificity": null,
    "property-no-vendor-prefix": null,
    "rule-empty-line-before": null,
    "selector-not-notation": null,
    "selector-pseudo-element-colon-notation": null,
    "shorthand-property-no-redundant-values": null,
    "hue-degree-notation": null,
    "value-keyword-case": [
      "lower",
      {
        "ignoreKeywords": [
          "currentColor"
        ],
        "ignoreProperties": [
          "/^--/",
          "font",
          "font-family"
        ]
      }
    ],
    "selector-pseudo-class-no-unknown": [
      true,
      {
        "ignorePseudoClasses": [
          "global",
          "local"
        ]
      }
    ],
    "declaration-property-value-no-unknown": [
      true,
      {
        "ignoreProperties": {
          "/^animation/": [
            "/global\\(/"
          ]
        }
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/**/*.module.css"
      ],
      "rules": {
        "selector-class-pattern": [
          "^[a-z][a-zA-Z0-9]*$",
          {
            "message": "Module classes are camelCase (see docs/styling.md)"
          }
        ],
        "keyframes-name-pattern": [
          "^[a-z][a-zA-Z0-9]*$",
          {
            "message": "Module keyframes are camelCase (see docs/styling.md)"
          }
        ],
        "color-no-hex": [
          true,
          {
            "message": "No hex colours in modules: use a token from static/tokens.css (see docs/styling.md)"
          }
        ],
        "declaration-property-value-disallowed-list": [
          {
            "/.*/": [
              "/(?:rgb|hsl)a?\\(\\s*[\\d.]/"
            ]
          },
          {
            "message": "No literal rgb()/hsl() colours in modules: use a token, or rgba(var(--x-rgb), a) (see docs/styling.md)"
          }
        ],
        "declaration-property-value-allowed-list": [
          {
            "z-index": [
              "auto",
              "/^-?\\d$/",
              "/^var\\(--z-[a-z-]+\\)$/"
            ],
            "border-radius": [
              "inherit",
              "/^(?:(?:0|var\\(--radius-[a-z-]+\\))\\s*)+$/"
            ]
          },
          {
            "message": "z-index must be var(--z-*) (or a single-digit local layer); border-radius must be var(--radius-*) (see docs/styling.md)"
          }
        ],
        "declaration-no-important": [
          true,
          {
            "message": "No !important in modules: raise specificity or fix the source rule (see docs/styling.md)"
          }
        ]
      }
    },
    {
      "files": [
        "static/**/*.css"
      ],
      "rules": {
        "selector-class-pattern": null,
        "keyframes-name-pattern": null,
        "declaration-property-value-keyword-no-deprecated": null,
        "property-no-deprecated": [
          true,
          {
            "ignoreProperties": [
              "clip"
            ]
          }
        ]
      }
    },
    {
      "files": [
        "static/style.css",
        "static/video/video-side.css"
      ],
      "rules": {
        "no-duplicate-selectors": null
      }
    },
    {
      "files": [
        "src/components/form/form.module.css",
        "src/components/media-player-bar/media-player-bar.module.css",
        "src/features/onboarding/checklist.module.css",
        "src/features/onboarding/onboarding.module.css",
        "src/features/playlists/add-to-playlist.module.css",
        "src/routes/active-downloads/-ui/adl-match.module.css",
        "src/routes/audiobooks/-ui/audiobook-library.module.css",
        "src/routes/audiobooks/-ui/audiobooks-page.module.css",
        "src/routes/import/-ui/import-page.module.css",
        "src/routes/issues/-ui/issue-detail-modal.module.css",
        "src/routes/issues/-ui/issue-status.module.css",
        "src/routes/issues/-ui/issues-page.module.css",
