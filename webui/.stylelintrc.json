        "src/routes/sample-studio/-ui/sample-studio-page.module.css",
        "src/routes/search/-ui/basic.module.css",
        "src/routes/search/-ui/enriched-modal.module.css",
        "src/routes/search/-ui/manual-modal.module.css",
        "src/routes/search/-ui/search.module.css",
        "src/routes/stats/-ui/stats-page.module.css",
        "src/routes/stats/-ui/year-story.module.css",
        "src/routes/sync/-ui/source-ref-modal.module.css",
        "src/routes/watchlist/-ui/watchlist-page.module.css",
        "src/routes/wishlist/-ui/wishlist-audiobooks.module.css"
      ],
      "rules": {
        "declaration-property-value-disallowed-list": null
      }
    },
    {
      "files": [
        "src/components/dialog/dialog.module.css",
        "src/components/media-player-bar/media-player-bar.module.css",
        "src/features/onboarding/checklist.module.css",
        "src/features/onboarding/onboarding.module.css",
        "src/features/playlists/add-to-playlist.module.css",
        "src/routes/audiobooks/-ui/audiobook-library.module.css",
        "src/routes/audiobooks/-ui/audiobooks-page.module.css",
        "src/routes/import/-ui/import-page.module.css",
        "src/routes/issues/-ui/issue-status.module.css",
